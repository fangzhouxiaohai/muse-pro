{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Pro",
  "version": "0.1.0",
  "identifier": "com.musepro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muse Pro",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#f4efe6",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "个人 AI 工作台",
    "longDescription": "Muse Pro 是一个本地优先的个人 AI 工作台，把对话、任务、目标、资料与需要审批的操作收拢在同一个空间里。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}

